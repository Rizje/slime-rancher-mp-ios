   -project "$ROOT/app/Madeira.xcodeproj" \
   -scheme Madeira \
@@ -39,12 +46,24 @@ xcodebuild \
   CODE_SIGNING_ALLOWED=NO \
   CODE_SIGNING_REQUIRED=NO \
   CODE_SIGN_IDENTITY='' \
+  ENABLE_DEBUG_DYLIB=NO \
+  ${bundle_id_args[@]+"${bundle_id_args[@]}"} \
   build
 
 [[ -d "$APP" ]] || { echo "ERROR: xcodebuild succeeded but Madeira.app is missing" >&2; exit 1; }
+# SR2 Launcher: the app's code in the Madeira executable itself, as in Madeira's 0.2.0 release (its log:
+# "ml989: running image .../Madeira"). Xcode's Debug default puts it in Madeira.debug.dylib behind a stub
+# executable instead; built that way, SR2 Launcher build 3 died as Wine connected to its server, on the
+# iPhone 16 Pro Max, before any of the launcher's own code ran.
+[[ ! -e "$APP/Madeira.debug.dylib" ]] || { echo "ERROR: Madeira.debug.dylib was built (ENABLE_DEBUG_DYLIB)" >&2; exit 1; }
 
 python3 "$ROOT/tools/build/runtime-components.py" bundle "$APP"
 
+# SR2 Launcher: which build this is, in Info.plist before the signature seals it. BuildStamp shows it
+# in the [build] log line and the Get Help file.
+plutil -replace MadeiraBuild -string \
+  "${MADEIRA_BUILD_STAMP:-0.2.0 · SR2 Launcher 1 · $(date -u '+%m-%d %H:%M') UTC}" "$APP/Info.plist"
+
