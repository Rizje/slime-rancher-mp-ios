diff --git a/app/Madeira/MadeiraConfig.swift b/app/Madeira/MadeiraConfig.swift
index e7d9ef0..271ba0f 100644
--- a/app/Madeira/MadeiraConfig.swift
+++ b/app/Madeira/MadeiraConfig.swift
@@ -271,3 +271,32 @@ enum MadeiraConfig {
         return removed
     }
 }
+
+/// SR2 Launcher, a build of Madeira 0.2.0 for Slime Rancher 2: the memory settings Slime Rancher 2's world
+/// loaded with on an 8 GB iPhone (16 Pro Max, 2026-11-09): Settings › Memory & sync › Swap tier 4 GB, Swap
+/// coverage "1 MB+ and overflow" and Donor pool 2 GB, the keys that page writes. Once per install, on a
+/// device under 10 GB (GameRecommendations.smallRAMDevice), and only keys madeira.cfg does not have: a value
+/// set by hand stays, and a change made later in Settings is never undone. Foundation only, because the
+/// host checks compile this file on its own.
+enum SR2Launcher {
+    static let seededKey = "sr2launcher.seeded.1"
+    static let memoryDefaults: [(key: String, value: String)] = [
+        ("swap-mb", "4096"), ("env.MADEIRA_SWAP_COVERAGE", "wide"), ("donor-pool-mb", "2048"),
+    ]
+
+    /// What it wrote, as key=value; empty when nothing was due. A write that fails is tried again at the
+    /// next start.
+    @discardableResult
+    static func seedDefaults(ramBytes: UInt64 = ProcessInfo.processInfo.physicalMemory,
+                             defaults: UserDefaults = .standard) -> [String] {
+        guard !defaults.bool(forKey: seededKey) else { return [] }
+        guard ramBytes < 10 << 30 else { defaults.set(true, forKey: seededKey); return [] }
+        var written: [String] = []
+        for item in memoryDefaults where MadeiraConfig.get(item.key) == nil {
+            guard MadeiraConfig.set(item.key, item.value) else { return written }
+            written.append("\(item.key)=\(item.value)")
+        }
+        defaults.set(true, forKey: seededKey)
+        return written
+    }
+}
