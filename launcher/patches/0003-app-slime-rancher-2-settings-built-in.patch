     private static let appliedKey = "madeira.recommended.applied"
+    /// SR2 Launcher: the version of the Slime Rancher 2 list this install has taken in full.
+    private static let sr2AppliedKey = "sr2launcher.applied"
 
     private enum Write: String { case firstSight = "first sight", updated, reset }
 
@@ -58,6 +60,27 @@ extension GameRecommendations {
     /// changed, so the caller saves the entry.
     @discardableResult
     static func prepare(_ entry: inout LibraryEntry, new: Bool = false) -> Bool {
+        // SR2 Launcher: this build exists for Slime Rancher 2, so that game takes its whole list once
+        // per list version, also when it is already in the library with a config of its own (what
+        // Reset to Recommended does). The config it replaces goes to the log first; later changes
+        // by the player stay until the list's version rises.
+        if entry.desktop != true, let rec = recommendation(for: entry), rec.id == slimeRancher2.id,
+           UserDefaults.standard.integer(forKey: sr2AppliedKey) < rec.version {
+            let previous = (GameProfile(windowsPath: entry.windowsPath).text + (entry.config ?? ""))
+                .trimmingCharacters(in: .whitespacesAndNewlines)
+            if !previous.isEmpty {
+                LogStore.shared.log("[recommended] \(entry.title): the config \(rec.id) v\(rec.version) replaces:\n\(previous)")
+            }
+            if !entry.arguments.isEmpty {
+                LogStore.shared.log("[recommended] \(entry.title): the launch arguments it replaces: \(entry.arguments)")
+            }
+            entry.config = nil
+            if put(rec, to: entry.windowsPath, .reset, title: entry.title) {
+                takeEntryFields(rec, &entry)
+                UserDefaults.standard.set(rec.version, forKey: sr2AppliedKey)
+                return true
+            }
+        }
         if let found = due(entry.windowsPath, recommendation(for: entry), ownLines: entry.config, title: entry.title),
            put(found.rec, to: entry.windowsPath, found.kind, title: entry.title, switches: new), found.kind == .firstSight {
             // A game already in the library keeps its own fields and switches (resolution,
@@ -177,6 +200,8 @@ extension GameRecommendations {
             else if let lines720 = ResolutionChoices.screen720Value { entry.resolution = lines720 }
         }
         if let mode = rec.display { entry.display = mode == DisplayMode.fit.rawValue ? nil : mode }
+        if let text = rec.arguments { entry.arguments = text }
+        if let factor = rec.metalFXUpscale { entry.metalFXUpscale = factor }
         if let mode = rec.launchMode { entry.launchMode = mode == "desktop" ? mode : nil }
         if let on = rec.startServices { entry.startServices = on ? true : nil }
     }
