+// SR2 Launcher: Slime Rancher 2's list is recognised like the other Steam titles, and taken in full once per
+// list version even by an entry that has a config of its own; after that the player's changes stay.
+let sr2Key = "sr2launcher.applied"
+UserDefaults.standard.removeObject(forKey: sr2Key)
+let sr2 = steam + #"\Slime Rancher 2"#
+check(id(sr2, 1657630) == "slime-rancher-2" && id(sr2) == "slime-rancher-2" && id(sr2 + #"\SlimeRancher2.exe"#) == "slime-rancher-2",
+      "Slime Rancher 2 by App ID, folder and program")
+GameProfile(windowsPath: sr2).text = "env.MADEIRA_EC_HOOK_TRACE = 0\nenv.FEX_MEMCPYSETTSOENABLED = 0\n"
+var slime = LibraryEntry(title: "Slime Rancher 2", windowsPath: sr2, steamAppID: 1657630)
+slime.config = "fence-chain = 1"; slime.arguments = "-force-d3d12"; slime.fpsMode = 2; slime.display = "fill"
+check(R.prepare(&slime) && file(sr2) == R.slimeRancher2.fileText && slime.config == nil && slime.arguments == ""
+      && slime.metalFXUpscale == 2 && slime.fpsMode == 3 && slime.resolution == "960x540" && slime.display == nil,
+      "Slime Rancher 2 with a config of its own takes the whole list")
+check(UserDefaults.standard.integer(forKey: sr2Key) == R.slimeRancher2.version, "the list's version is recorded")
+check(LogStore.shared.lines.contains { $0.contains("slime-rancher-2 v1 replaces:") && $0.contains("FEX_MEMCPYSETTSOENABLED") && $0.contains("fence-chain = 1") }
+      && LogStore.shared.lines.contains { $0.hasSuffix("the launch arguments it replaces: -force-d3d12") }, "what it replaced is logged")
+GameProfile(windowsPath: sr2).text = R.slimeRancher2.fileText + "env.MADEIRA_FPS_GOV_MAX = 40\n"
+slime.arguments = "-screen-fullscreen 0"; slime.fpsMode = 1
+check(!R.prepare(&slime) && file(sr2).hasSuffix("env.MADEIRA_FPS_GOV_MAX = 40\n") && slime.arguments == "-screen-fullscreen 0"
+      && slime.fpsMode == 1, "once taken, the player's own changes stay")
+check(R.reset(&slime)?.id == "slime-rancher-2" && file(sr2) == R.slimeRancher2.fileText && slime.arguments == "" && slime.fpsMode == 3,
+      "Reset to Recommended brings the list back")
+check(R.slimeRancher2.switchSummary.contains("MetalFX upscaling 2x") && R.slimeRancher2.switchSummary.contains("no launch arguments"),
